# 이 파일을 복사해 .env를 만드세요: cp .env.example .env
# 항목 설명: docs/03_architecture.md#환경-변수-envexample

# Claude API 키 — 서버에서만 사용, 절대 커밋 금지 (Mock 모드에서는 비워도 됨)
ANTHROPIC_API_KEY=

# 사용할 모델 ID (코드에 고정하지 않음)
ANTHROPIC_MODEL=

# Claude API 주소 — 비우면 공식 주소. 사내 게이트웨이를 거칠 때만 바꿈
ANTHROPIC_BASE_URL=

# Claude 호출 1회 제한 시간(ms)
ANTHROPIC_TIMEOUT_MS=60000

# true면 Claude API 대신 fixtures/ 샘플을 반환
USE_MOCK=true

# API 서버 포트 (웹 개발 서버가 /api 요청을 이 포트로 넘김)
PORT=3001
